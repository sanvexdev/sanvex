{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Sanvex",
  "theme": "mint",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "logo": {
    "light": "/public/logo.png",
    "dark": "/public/logo.png",
    "href": "https://github.com/sanvexdev/sanvex"
  },
  "favicon": "/public/logo.png",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/sanvexdev/sanvex"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/getting-started/quickstart"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/integration",
              "getting-started/installation",
              "getting-started/usage"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/packages",
              "concepts/database",
              "concepts/configuration",
              "concepts/authentication",
              "concepts/oauth",
              "concepts/tenancy"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/laravel-ai",
              "integrations/mcp"
            ]
          }
        ]
      },
      {
        "tab": "Drivers",
        "icon": "plug",
        "groups": [
          {
            "group": "Overview",
            "pages": ["drivers/index"]
          },
          {
            "group": "GitHub",
            "pages": [
              "drivers/github/overview",
              "drivers/github/configuration",
              "drivers/github/setup",
              "drivers/github/resources"
            ]
          },
          {
            "group": "Gmail",
            "pages": [
              "drivers/gmail/overview",
              "drivers/gmail/configuration",
              "drivers/gmail/setup",
              "drivers/gmail/resources"
            ]
          },
          {
            "group": "Linear",
            "pages": [
              "drivers/linear/overview",
              "drivers/linear/configuration",
              "drivers/linear/setup",
              "drivers/linear/resources"
            ]
          },
          {
            "group": "Notion",
            "pages": [
              "drivers/notion/overview",
              "drivers/notion/configuration",
              "drivers/notion/setup",
              "drivers/notion/resources"
            ]
          },
          {
            "group": "Slack",
            "pages": [
              "drivers/slack/overview",
              "drivers/slack/configuration",
              "drivers/slack/setup",
              "drivers/slack/resources"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/sanvexdev/sanvex"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sanvexdev/sanvex"
    }
  }
}
