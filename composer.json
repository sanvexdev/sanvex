{
    "name": "sanvex/ecosystem",
    "description": "An AI-agentic ecosystem and unified API integration layer for Laravel",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sanvex/core": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Sanvex\\Core\\Tests\\": "packages/core/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        },
        {
            "type": "path",
            "url": "packages/drivers/*"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
